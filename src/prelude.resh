// Standard library. Written in resh itself; bodies are native Rust.

ENUM Sort Key { name, size, modified time, extension, unsorted }

// Mirrors `ls`: recursive = -R, include hidden file = -A, directory itself = -d,
// reverse = -r, follow symlink = -L, sort by = (-S | -t | -X | -U; default by name).
RECORD List Options {
    recursive?: Boolean,
    include hidden file?: Boolean,
    directory itself?: Boolean,
    reverse?: Boolean,
    follow symlink?: Boolean,
    sort by?: Sort Key
}

ENUM Entry Kind { file, directory, symlink }

// Every field `ls -l -i -s` can show; times are Unix seconds, `size` is bytes (0 for non-files).
RECORD Entry {
    (self) path: String,
    (self) kind: Entry Kind,
    (self) size: Int,
    file name of (self): String,
    permissions of (self): String,
    mode of (self): Int,
    link count of (self): Int,
    owner id of (self): Int,
    group id of (self): Int,
    modified at of (self): Int,
    accessed at of (self): Int,
    inode number of (self): Int,
    block count of (self): Int,
    link target of (self)?: String
}

FUNCTION list file: Result (List (Entry)) Or (String) { NATIVE "list_default" }
FUNCTION list file in (dir: String): Result (List (Entry)) Or (String) { NATIVE "list_in_default" }
FUNCTION list file (options: List Options): Result (List (Entry)) Or (String) { NATIVE "list_file" }
FUNCTION list file in (dir: String) (options: List Options): Result (List (Entry)) Or (String) { NATIVE "list_file_in" }
FUNCTION read file (path: String): Result (String) Or (String) { NATIVE "read_file" }
FUNCTION write (text: String) to file (path: String): Result (Unit) Or (String) { NATIVE "write_file" }
FUNCTION move (from: String) to (to: String): Result (Unit) Or (String) { NATIVE "move_path" }

FUNCTION print (value: T): Unit { NATIVE "print" }
FUNCTION count (items: List (T)): Int { NATIVE "count" }
FUNCTION filter (items: List (Entry)) by extension (extension: String): List (Entry) { NATIVE "filter_ext" }
FUNCTION lines of (text: String): List (String) { NATIVE "lines_of" }
FUNCTION join (a: String) with (b: String): String { NATIVE "join_with" }
FUNCTION (a: T) equals (b: T): Boolean { NATIVE "equals" }
FUNCTION unwrap (result: Result (T) Or (E)): T { NATIVE "unwrap" }
FUNCTION human size of (bytes: Int): String { NATIVE "human_size" }
