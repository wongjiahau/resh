# Wrapper for `git` (read-only commands), written in resh (see SYNTAX.md, "Running external commands").
# `status` lines are `XY path` (porcelain v1), `log` lines are `short-hash subject`, and `diff`
# is the unified diff text. Nothing here modifies the repository.

NAMESPACE : git,

ENUM : Untracked Mode : { all, normal, hidden },

ENUM : Status Option : {
    untracked (Untracked Mode),          # default normal    (--untracked-files=all | normal | no)
    ignored,                             # --ignored
    branch                               # --branch: first line is `## branch...upstream`
},

ENUM : Log Option : {
    max count (Int),                     # --max-count
    author (String),                     # --author
    message matching (String),           # --grep
    changed within (Duration),           # --since
    changed before (Duration),           # --until
    no merge,                            # --no-merges
    oldest first,                        # --reverse
    first parent                         # --first-parent
},

ENUM : Diff Option : {
    staged,                              # --cached
    against (String),                    # a revision, e.g. `HEAD~3`
    name only,                           # --name-only
    stat,                                # --stat
    ignore whitespace,                   # --ignore-all-space
    context (Int)                        # --unified
},

FUNCTION : (option: Status Option) argument . RETURNS (List (String)) : {
    MATCH (option) {
        untracked (all) . THEN : ["--untracked-files=all"],
        untracked (normal) . THEN : [],
        untracked (hidden) . THEN : ["--untracked-files=no"],
        ignored . THEN : ["--ignored"],
        branch . THEN : ["--branch"]
    }
},

FUNCTION : (option: Log Option) argument . RETURNS (List (String)) : {
    MATCH (option) {
        max count (n) . THEN : ["--max-count", n . to string],
        author (name) . THEN : ["--author", name],
        message matching (pattern) . THEN : ["--grep", pattern],
        changed within (d) . THEN : [join "--since=" with : join (d . seconds text) with " seconds ago"],
        changed before (d) . THEN : [join "--until=" with : join (d . seconds text) with " seconds ago"],
        no merge . THEN : ["--no-merges"],
        oldest first . THEN : ["--reverse"],
        first parent . THEN : ["--first-parent"]
    }
},

FUNCTION : (option: Diff Option) argument . RETURNS (List (String)) : {
    MATCH (option) {
        staged . THEN : ["--cached"],
        against (revision) . THEN : [revision],
        name only . THEN : ["--name-only"],
        stat . THEN : ["--stat"],
        ignore whitespace . THEN : ["--ignore-all-space"],
        context (n) . THEN : ["--unified", n . to string]
    }
},

FUNCTION : (duration: Duration) seconds text . RETURNS (String) : { duration . seconds . to string },

FUNCTION : status (options: Set (Status Option)) . RETURNS (Result (List (String))) : {
    run ("git", ["status", "--porcelain=v1", SPREAD (flat map (options) with : FN (o) : (o) argument)])
        . map _ with : FN (text) : (text) lines
},

FUNCTION : status . RETURNS (Result (List (String))) : {
    status {}
},

FUNCTION : log (options: Set (Log Option)) touching (paths: List (String))
    . RETURNS (Result (List (String))) : {
    run ("git", [
        "log", "--format=%h %s",
        SPREAD (flat map (options) with : FN (o) : (o) argument),
        "--", SPREAD (paths)
    ])
        . map _ with : FN (text) : (text) lines
},

FUNCTION : log (options: Set (Log Option)) . RETURNS (Result (List (String))) : {
    log (options) touching []
},

FUNCTION : log . RETURNS (Result (List (String))) : {
    log {} touching []
},

FUNCTION : diff (options: Set (Diff Option)) touching (paths: List (String)) . RETURNS (Result (String)) : {
    run ("git", ["diff", SPREAD (flat map (options) with : FN (o) : (o) argument), "--", SPREAD (paths)])
},

FUNCTION : diff (options: Set (Diff Option)) . RETURNS (Result (String)) : {
    diff (options) touching []
},

FUNCTION : diff . RETURNS (Result (String)) : {
    diff {} touching []
}

# Usage:
#   git.status,
#   git.{
#       status { untracked (all), branch },
#       log { max count 5, author "alice", no merge },
#       log { changed within (7 days) } touching ["src"],
#       diff { staged, stat },
#       diff { against "HEAD~3", name only } touching ["src", "tests"],
#   }
