# Wrapper for `git` (read-only commands), written in resh (see SYNTAX.md, "Running external commands").
# `status` lines are `XY path` (porcelain v1), `log` lines are `short-hash subject`, and `diff`
# is the unified diff text. Nothing here modifies the repository.

NAMESPACE git,

ENUM Untracked Mode HAS { all, normal, hidden },

ENUM Status Option HAS {
    untracked (Untracked Mode),          # default normal    (--untracked-files=all | normal | no)
    ignored,                             # --ignored
    branch                               # --branch: first line is `## branch...upstream`
},

ENUM Log Option HAS {
    max count (Int),                     # --max-count
    author (String),                     # --author
    message matching (String),           # --grep
    changed within (Duration),           # --since
    changed before (Duration),           # --until
    no merge,                            # --no-merges
    oldest first,                        # --reverse
    first parent                         # --first-parent
},

ENUM Diff Option HAS {
    staged,                              # --cached
    against (String),                    # a revision, e.g. `HEAD~3`
    name only,                           # --name-only
    stat,                                # --stat
    ignore whitespace,                   # --ignore-all-space
    context (Int)                        # --unified
},

FUNCTION (option: Status Option) argument RETURNS List (String) DO {
    MATCH option WITH {
        untracked (all) : ["--untracked-files=all"],
        untracked (normal) : [],
        untracked (hidden) : ["--untracked-files=no"],
        ignored : ["--ignored"],
        branch : ["--branch"]
    }
},

FUNCTION (option: Log Option) argument RETURNS List (String) DO {
    MATCH option WITH {
        max count (n) : ["--max-count", n . to string],
        author (name) : ["--author", name],
        message matching (pattern) : ["--grep", pattern],
        changed within (d) : [join "--since=" with : join (d . seconds text) with " seconds ago"],
        changed before (d) : [join "--until=" with : join (d . seconds text) with " seconds ago"],
        no merge : ["--no-merges"],
        oldest first : ["--reverse"],
        first parent : ["--first-parent"]
    }
},

FUNCTION (option: Diff Option) argument RETURNS List (String) DO {
    MATCH option WITH {
        staged : ["--cached"],
        against (revision) : [revision],
        name only : ["--name-only"],
        stat : ["--stat"],
        ignore whitespace : ["--ignore-all-space"],
        context (n) : ["--unified", n . to string]
    }
},

FUNCTION (duration: Duration) seconds text RETURNS String DO { duration . seconds . to string },

FUNCTION status (options: Set (Status Option)) RETURNS Result (List (String)) DO {
    run ("git", ["status", "--porcelain=v1", SPREAD (flat map (options) with : FN o DO (o) argument)])
        . map _ with : FN text DO (text) lines
},

FUNCTION status RETURNS Result (List (String)) DO {
    status {}
},

FUNCTION log (options: Set (Log Option)) touching (paths: List (String))
    RETURNS Result (List (String)) DO {
    run ("git", [
        "log", "--format=%h %s",
        SPREAD (flat map (options) with : FN o DO (o) argument),
        "--", SPREAD paths
    ])
        . map _ with : FN text DO (text) lines
},

FUNCTION log (options: Set (Log Option)) RETURNS Result (List (String)) DO {
    log (options) touching []
},

FUNCTION log RETURNS Result (List (String)) DO {
    log {} touching []
},

FUNCTION diff (options: Set (Diff Option)) touching (paths: List (String)) RETURNS Result (String) DO {
    run ("git", ["diff", SPREAD (flat map (options) with : FN o DO (o) argument), "--", SPREAD paths])
},

FUNCTION diff (options: Set (Diff Option)) RETURNS Result (String) DO {
    diff (options) touching []
},

FUNCTION diff RETURNS Result (String) DO {
    diff {} touching []
}

# Usage:
#   git -> status,
#   git -> {
#       status { untracked (all), branch },
#       log { max count 5, author "alice", no merge },
#       log { changed within (7 days) } touching ["src"],
#       diff { staged, stat },
#       diff { against "HEAD~3", name only } touching ["src", "tests"],
#   }
