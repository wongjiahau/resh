# Standard library. Written in resh itself; bodies are native Rust.

## The result of comparing two values; see the `int` and `string` namespaces.
ENUM Ordering HAS { less, equal, greater },

ENUM Sort Key HAS { name, size, modified time, extension, unsorted },

## Mirrors `ls`: recursive = -R, include hidden file = -A, directory itself = -d,
## reverse = -r, follow symlink = -L, sort by = (-S | -t | -X | -U; default by name).
RECORD List Options HAS {
    recursive (Boolean DEFAULT false),
    include hidden file (Boolean DEFAULT false),
    directory itself (Boolean DEFAULT false),
    reverse (Boolean DEFAULT false),
    follow symlink (Boolean DEFAULT false),
    sort by (Sort Key DEFAULT name)
},

## A fallible result whose error is a message.
TYPE Result (T) BE Result (T) Or (String),

ENUM Entry Kind HAS { file, directory, symlink },

## Every field `ls -l -i -s` can show; times are Unix seconds, `size` is bytes (0 for non-files).
## Read it with a single-case MATCH.
RECORD Entry HAS {
    path (String),
    kind (Entry Kind),
    size (Int),
    file name (String),
    permissions (String),
    mode (Int),
    link count (Int),
    owner id (Int),
    group id (Int),
    modified at (Int),
    accessed at (Int),
    inode number (Int),
    block count (Int),
    link target (Option (String))
},

FUNCTION list file RETURNS Result (List (Entry)) DO { NATIVE "list_default" },
FUNCTION list file in (dir: String) RETURNS Result (List (Entry)) DO { NATIVE "list_in_default" },
FUNCTION list file (options: List Options) RETURNS Result (List (Entry)) DO { NATIVE "list_file" },
FUNCTION list file in (dir: String) (options: List Options) RETURNS Result (List (Entry)) DO { NATIVE "list_file_in" },
## Sets the directory that `run` (and so every wrapper) and the file functions use from now on.
FUNCTION change directory to (path: String) RETURNS Result (Unit) DO { NATIVE "change_dir" },
FUNCTION current directory RETURNS Result (String) DO { NATIVE "current_dir" },
FUNCTION read file (path: String) RETURNS Result (String) DO { NATIVE "read_file" },
FUNCTION write (text: String) to file (path: String) RETURNS Result (Unit) DO { NATIVE "write_file" },
FUNCTION move (from: String) to (to: String) RETURNS Result (Unit) DO { NATIVE "move_path" },

FUNCTION run ((command: String, args: List (String))) RETURNS Result (String) DO { NATIVE "run" },
FUNCTION print (value: T) RETURNS Unit DO { NATIVE "print" },
FUNCTION count (items: List (T)) RETURNS Int DO { NATIVE "count" },
FUNCTION filter (items: List (Entry)) by extension (extension: String) RETURNS List (Entry) DO { NATIVE "filter_ext" },
FUNCTION flat map (items: List (T)) with (f: Function (T) To (List (U))) RETURNS List (U) DO { NATIVE "flat_map" },
FUNCTION flat map (items: Set (T)) with (f: Function (T) To (List (U))) RETURNS List (U) DO { NATIVE "flat_map" },
FUNCTION map (result: Result (T) Or (E)) with (f: Function (T) To (U)) RETURNS Result (U) Or (E) DO { NATIVE "map_result" },
FUNCTION (n: Int) to string RETURNS String DO { NATIVE "int_to_string" },
FUNCTION (n: Float) to string RETURNS String DO { NATIVE "float_to_string" },
FUNCTION (text: String) lines RETURNS List (String) DO { NATIVE "lines_of" },
FUNCTION (text: String) split on (separator: String) at most (parts: Int) RETURNS List (String) DO { NATIVE "split_on" },
FUNCTION (items: List (T)) item (index: Int) RETURNS (T) DO { NATIVE "item_at" },
FUNCTION (text: String) to int RETURNS Result (Int) DO { NATIVE "string_to_int" },
FUNCTION join (a: String) with (b: String) RETURNS String DO { NATIVE "join_with" },
FUNCTION join (a: List (T)) with (b: List (T)) RETURNS List (T) DO { NATIVE "join_with" },
FUNCTION (a: T) equals (b: T) RETURNS Boolean DO { NATIVE "equals" },
FUNCTION unwrap (result: Result (T) Or (E)) RETURNS (T) DO { NATIVE "unwrap" },
FUNCTION human size of (bytes: Int) RETURNS String DO { NATIVE "human_size" },

## Units. `Size` is held in bytes and `Duration` in seconds; construct them only
## with the suffix functions below (`1 mb`, `5 days`), read them with the accessors.
RECORD Size HAS { byte count (Int) },
RECORD Duration HAS { second count (Int) },

FUNCTION (n: Int) kb RETURNS Size DO { NATIVE "unit_kb" },
FUNCTION (n: Int) mb RETURNS Size DO { NATIVE "unit_mb" },
FUNCTION (n: Int) gb RETURNS Size DO { NATIVE "unit_gb" },
FUNCTION (n: Int) seconds RETURNS Duration DO { NATIVE "unit_seconds" },
FUNCTION (n: Int) minutes RETURNS Duration DO { NATIVE "unit_minutes" },
FUNCTION (n: Int) hours RETURNS Duration DO { NATIVE "unit_hours" },
FUNCTION (n: Int) days RETURNS Duration DO { NATIVE "unit_days" },
FUNCTION (duration: Duration) ago RETURNS Duration DO { NATIVE "unit_ago" },
FUNCTION (size: Size) bytes RETURNS Int DO { NATIVE "unit_count" },
FUNCTION (duration: Duration) seconds RETURNS Int DO { NATIVE "unit_count" }
